/* Sleek macOS Spotlight-like Theme (Solid Colors) */
* {
    bg: #11111B;       
    bg-alt: #313244;
    fg: #CDD6F4;       
    accent: #89B4FA;       
    border-col: #313244;
    
    font: "JetBrainsMono Nerd Font 13";
    background-color: transparent;
    text-color: @fg;
    border: 0px;
    margin: 0px;
    padding: 0px;
}

window {
    width: 650px;
    orientation: vertical;
    location: center;
    anchor: center;
    border-color: @border-col;
    border: 1px;
    border-radius: 14px;
    spacing: 0;
    background-color: @bg;
    children: [ mainbox ];
}

mainbox {
    spacing: 0;
    children: [ inputbar, listview ];
}

inputbar {
    color: @fg;
    padding: 18px 24px;
    border: 0px 0px 1px 0px;
    border-color: @border-col;
    background-color: transparent;
    spacing: 16px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 16";
    vertical-align: 0.5;
}

entry {
    placeholder: "Search...";
    placeholder-color: #585B70;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 16";
    vertical-align: 0.5;
}

listview {
    layout: vertical;
    spacing: 4px;
    padding: 12px;
    lines: 7;
    columns: 1;
    background-color: transparent;
    dynamic: true;
}

element {
    padding: 10px 14px;
    spacing: 14px;
    background-color: transparent;
    text-color: @fg;
    border-radius: 8px;
}

element selected.normal {
    background-color: @bg-alt;
    text-color: @fg; 
}

element-icon {
    background-color: transparent;
    text-color: inherit;
    size: 1.8em;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}
